    public static void main(String[] args) throws Exception {
        int pass = 0, fail = 0;
        java.io.PrintStream out = new java.io.PrintStream(System.out, true, "UTF-8");
        // ---- main ru2zh suite (tests.tsv): "фраза<TAB>ожидаемый_ZH[<TAB>UNSAFE]"; NULL = null ----
        for (String line : Files.readAllLines(Paths.get(args[0]))) {
            if (line.isBlank() || line.startsWith("#")) continue;
            String[] p = line.split("\\t");
            if (p.length < 2) continue;
            String ru = p[0].trim();
            String exp = p[1].trim().equals("NULL") ? null : p[1].trim();
            boolean unsafeCase = p.length > 2 && p[2].trim().equals("UNSAFE");
            if (unsafeCase) {
                // при ALLOW_UNSAFE=false команда обязана блокироваться, при true — давать ожидаемую фразу
                ALLOW_UNSAFE = false;
                String blocked = ru2zh(ru);
                ALLOW_UNSAFE = true;
                String got = ru2zh(ru);
                ALLOW_UNSAFE = false;
                if (blocked == null && Objects.equals(got, exp)) pass++;
                else { fail++; out.println("FAIL[unsafe] '" + ru + "' -> blocked=" + blocked + " open=" + got + "  (exp " + exp + ")"); }
            } else {
                String got = ru2zh(ru);
                if (Objects.equals(got, exp)) pass++;
                else { fail++; out.println("FAIL '" + ru + "' -> " + got + "  (exp " + exp + ")"); }
            }
        }
        // ---- chatter audit (chatter.txt): болтовня/вопросы НЕ должны становиться командами ----
        java.nio.file.Path ch = Paths.get(args.length > 1 ? args[1] : "chatter.txt");
        if (Files.exists(ch)) {
            ALLOW_UNSAFE = true;   // показываем, что БЫЛО БЫ заинжектировано
            for (String line : Files.readAllLines(ch)) {
                if (line.isBlank() || line.startsWith("#")) continue;
                String got = ru2zh(line.trim());
                if (got == null) pass++;
                else { fail++; out.println("FAIL[chatter] '" + line.trim() + "' -> " + got + "  (должно быть чат)"); }
            }
            ALLOW_UNSAFE = false;
        }
        out.println("PASS=" + pass + " FAIL=" + fail);
        System.exit(fail == 0 ? 0 : 1);
    }
}
